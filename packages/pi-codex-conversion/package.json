{
  "name": "@mkaros2025/pi-codex-compat",
  "version": "0.1.0",
  "description": "Four Codex-compatible tools for Pi with model-based activation",
  "keywords": ["pi-package", "pi", "codex"],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkaros2025/pi-codex-tools.git",
    "directory": "packages/pi-codex-conversion"
  },
  "homepage": "https://github.com/mkaros2025/pi-codex-tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "src/tools/**/bin/**",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "THIRD_PARTY-NATIVE.md",
    "UPSTREAM-NATIVE.md"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@gotgenes/pi-permission-system": ">=32.0.0"
  },
  "peerDependenciesMeta": {
    "@gotgenes/pi-permission-system": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.29"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
