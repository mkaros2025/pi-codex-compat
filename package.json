{
  "name": "pi-codex-tools-repo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "codex"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-codex-conversion/dist/index.js"
    ]
  },
  "scripts": {
    "prepare": "npm run --workspace=pi-codex-tools build",
    "check": "npm run --workspace=pi-codex-tools check",
    "typecheck": "npm run --workspace=pi-codex-tools typecheck",
    "test": "npm run --workspace=pi-codex-tools test",
    "build": "npm run --workspace=pi-codex-tools build"
  }
}
