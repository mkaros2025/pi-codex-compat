{
  "name": "pi-codex-compat-repo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "codex"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-codex-compat/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run --workspace=@mkaros2025/pi-codex-compat check",
    "typecheck": "npm run --workspace=@mkaros2025/pi-codex-compat typecheck",
    "test": "npm run --workspace=@mkaros2025/pi-codex-compat test",
    "build": "npm run --workspace=@mkaros2025/pi-codex-compat build"
  }
}
